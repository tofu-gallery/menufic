# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# When adding additional env variables, the schema in /env/schema.mjs should be updated accordingly

# Tofu: Google, GitHub, the test login key, ImageKit and Sentry are gone, and the owner's password is the one way in
# (see TOFU.md). On Tofu, DATABASE_URL and SUPABASE_CA_CERT come from the app's managed database, and nothing else here
# needs to be set but MENUFIC_ADMIN_PASSWORD.

NODE_ENV=development

# Set this to true during CI checks
SKIP_ENV_VALIDATION=true

# Prisma
# Database
DATABASE_URL=postgresql://user:password@localhost:34837/menufic_db
# The database server's root certificate (PEM text). When set, the server's certificate and host name are verified.
SUPABASE_CA_CERT=

# The owner's password: at least 12 characters. Unset, nobody can sign in. On Tofu, save it as a hidden value.
MENUFIC_ADMIN_PASSWORD=

# Next Auth
# Off Vercel, NEXTAUTH_URL is the app's own address (or set AUTH_TRUST_HOST=true behind a proxy that sets the host).
# NEXTAUTH_SECRET is optional: unset, it is derived from DATABASE_URL and MENUFIC_ADMIN_PASSWORD.
# More info: https://next-auth.js.org/configuration/options#secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

##############################################
## Following are the optional env variables ##
##############################################

# Usage limits
NEXT_PUBLIC_MAX_RESTAURANTS_PER_USER=5
NEXT_PUBLIC_MAX_MENUS_PER_RESTAURANT=5
NEXT_PUBLIC_MAX_CATEGORIES_PER_MENU=10
NEXT_PUBLIC_MAX_MENU_ITEMS_PER_CATEGORY=20
NEXT_PUBLIC_MAX_BANNERS_PER_RESTAURANT=5

# For sample menu shown in landing page (hidden while unset)
NEXT_PUBLIC_SAMPLE_MENU_ID=""

# Deployed URL used in the pages' link previews
NEXT_PUBLIC_PROD_URL=http://localhost:3000
